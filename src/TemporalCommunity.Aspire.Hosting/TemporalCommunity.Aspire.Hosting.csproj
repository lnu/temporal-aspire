<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>TemporalCommunity.Aspire.Hosting</PackageId>
    <Title>Temporal Community Aspire Hosting</Title>
    <Description>.NET Aspire hosting integration for working with Temporal server resources.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>temporal;aspire;hosting;distributed;integration</PackageTags>
    <!-- MinVer owns Version — do NOT set <Version> here -->
    <NoWarn>
      $(NoWarn);CS1574;CS1591;SA1010;SA1116;SA1413;SA1117;CA1031;SA1503;CS0109;CA1002;CA1062;CA1305;CA1848;CA1873;CA2007;CA2227</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Temporalio" Version="1.20.0" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
